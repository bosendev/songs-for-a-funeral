# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# 2 space indentation
[*.{js,jsx,ts,tsx,json,css,scss,html,twig,vue}]
indent_style = space
indent_size = 2

# 4 space indentation for PHP (Craft CMS convention)
[*.php]
indent_style = space
indent_size = 4

# Markdown
[*.md]
trim_trailing_whitespace = false
