# Craft CMS
# =========

# Storage (runtime, logs, backups)
/storage/*
!/storage/.gitkeep

# Uploads (user-generated content)
/web/uploads/*
!/web/uploads/.gitkeep

# Compiled assets (generated by Vite)
/web/dist/*
!/web/dist/.gitkeep

# CP Resources (Craft admin assets)
/web/cpresources/*

# Composer
/vendor/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Environment & Config
.env
.env.local
.env.*.local

# DDEV (optional - some teams commit this, some don't)
# DDEV
.ddev/
.ddev/.gitignore
.ddev/db_snapshots/
.ddev/import-db/
.ddev/.dbimageBuild/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
*.log
*.cache

# Temporary files
*.tmp
*.temp
.cache/

# SSL certificates (if any local certs generated)
*.pem
*.crt
*.key

# Package lock files (optional - some teams commit these)
# Uncomment if you want to gitignore them:
# package-lock.json
# composer.lock
