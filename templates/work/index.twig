{# templates/work/index.twig #}
{% extends "_layouts/_layout.twig" %}
{% import '_macros/picture.twig' as picture %}



{% block content %}

<section class="work-index w-full max-w-[1024px] mx-auto">
  <ul class="work-index__list">
    {% for entry in craft.entries.section('work').all() %}
      <li class="work-index__item">
        <a href="{{ entry.url }}" class="work-index__link">
          {% if entry.photo.one() %}
            <div class="work-index__thumb">
              {{ picture.portfolio(entry.photo.one(), entry.title, 600, 'work-index__img', false) }}
            </div>
          {% endif %}
          {# <h2 class="work-index__title">{{ entry.title }}</h2> #}
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
