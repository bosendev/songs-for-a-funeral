{% extends "_layouts/_layout.twig" %}
{% import '_macros/picture.twig' as picture %}

{% block content %}
<div class="container mx-auto px-4 py-12">
  <h1 class="text-4xl font-bold mb-8">Work</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for entry in craft.entries.section('work').all() %}
      <a href="{{ entry.url }}" class="block">
        {% if entry.photo.one() %}
          {{ picture.portfolio(entry.photo.one(), entry.title, 600, 'w-full h-64 object-cover mb-4') }}
        {% endif %}
        <h2 class="text-xl font-semibold">{{ entry.title }}</h2>
      </a>
    {% endfor %}
  </div>
</div>
{% endblock %}
