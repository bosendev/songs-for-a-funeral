{# templates/index.twig #}
{% extends '_layouts/_layout.twig' %}
{% import '_macros/picture.twig' as picture %}

{% block content %}
<section class="home mx-auto max-w-[802px] w-full">

  {% if entry.photo.one() %}
    <div class="home__hero">
      {{ picture.portfolio(entry.photo.one(), entry.title, 1200, 'home__hero-img', false) }}
    </div>
  {% endif %}

  {% if entry.introText %}
    <div class="home__intro">
      {{ entry.introText | raw }}
    </div>
  {% endif %}

  {% if entry.essayCk %}
    <div class="home__essay">
      {{ entry.essayCk | raw }}
    </div>
  {% endif %}

</section>
{% endblock %}
