//templates/_macros/picture.twig
{% macro portfolio(image, alt, size = 800, classes = '') %}
  {% if image %}
    <picture>
      <source
        srcset="{{ image.getUrl({ width: size, format: 'avif' }) }}"
        type="image/avif">

      <source
        srcset="{{ image.getUrl({ width: size, format: 'avif' }) }}"
        type="image/webp">

      <img
        src="{{ image.getUrl({ width: size, format: 'avif' }) }}"
        alt="{{ alt }}"
        width="{{ size }}"
        height="{{ size }}"
        loading="lazy"
        class="{{ classes }}"
        tabindex="0"
        role="button">
    </picture>
  {% endif %}
{% endmacro %}
