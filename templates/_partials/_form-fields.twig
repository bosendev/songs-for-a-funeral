{# templates/_partials/_form-fields.twig #}

<input type="hidden" name="form-name" value="print-request">
{% if entry is defined %}
  <input type="hidden" name="image" value="{{ entry.title }}">
{% endif %}

<p class="text-xs italic mb-4" style="color: rgb(255 255 255 / 60%)"><span class="text-red-500">*</span> Required</p>

<div class="grid grid-cols-1 min-[480px]:grid-cols-2 gap-4">
  <div class="modal__field">
    <label for="first-name">First Name <span class="text-red-500">*</span></label>
    <input type="text" id="first-name" name="first_name" required>
  </div>

  <div class="modal__field">
    <label for="last-name">Last Name <span class="text-red-500">*</span></label>
    <input type="text" id="last-name" name="last_name" required>
  </div>
</div>

<div class="modal__field">
  <label for="email">Email <span class="text-red-500">*</span></label>
  <input type="email" id="email" name="email" required>
</div>

<div class="modal__field">
  <label for="street">Street Address <span class="text-red-500">*</span></label>
  <input type="text" id="street" name="street" required>
</div>

<div class="grid grid-cols-1 min-[480px]:grid-cols-2 gap-4">
  <div class="modal__field">
    <label for="city">City <span class="text-red-500">*</span></label>
    <input type="text" id="city" name="city" required>
  </div>

  <div class="modal__field">
    <label for="state">State / Province <span class="text-red-500">*</span></label>
    <input type="text" id="state" name="state" required>
  </div>
</div>

<div class="grid grid-cols-1 min-[480px]:grid-cols-2 gap-4">
  <div class="modal__field">
    <label for="postal">Postal Code <span class="text-red-500">*</span></label>
    <input type="text" id="postal" name="postal" required>
  </div>

  <div class="modal__field">
    <label for="country">Country <span class="text-red-500">*</span></label>
    <input type="text" id="country" name="country" required>
  </div>
</div>

<div class="modal__field">
  <label for="comments">Comments</label>
  <textarea id="comments" name="comments" rows="3"></textarea>
</div>

<div class="modal__form-buttons">
  <button type="submit" class="modal__submit">Send Request</button>
  {% if hasEssay is defined and hasEssay %}
    <button type="button" class="modal__cancel modal__form-dismiss" aria-label="Dismiss print request form">Cancel</button>
  {% else %}
    <button type="button" class="modal__cancel" aria-label="Cancel and close">Cancel</button>
  {% endif %}
</div>
