{# templates/_partials/_modal-no-essay.twig #}
{# templates/_partials/_modal-no-essay.twig #}

<div class="modal-overlay modal-overlay--no-entry" aria-hidden="true">
  <dialog
    class="modal"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <header class="modal__header">
      {% if entry is defined and entry.section.handle == 'work' %}
        <h2 class="modal__title" id="modal-title">{{ entry.title }}</h2>
      {% endif %}
      <button class="modal__close" aria-label="Close dialog">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
          <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </header>

    <div class="modal__body">
      <form class="modal__form" name="print-request" method="POST" netlify>
        <input type="hidden" name="form-name" value="print-request">
        {% if entry is defined %}
          <input type="hidden" name="image" value="{{ entry.title }}">
        {% endif %}

        <div class="modal__field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="modal__field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>

        <div class="modal__field">
          <label for="address">Mailing Address</label>
          <textarea id="address" name="address" rows="3" required></textarea>
        </div>

        <div class="modal__field">
          <label for="comments">Comments</label>
          <textarea id="comments" name="comments" rows="3"></textarea>
        </div>

        <div class="modal__form-buttons">
          <button type="submit" class="modal__submit">Send Request</button>
          <button type="button" class="modal__cancel" aria-label="Cancel and close">Cancel</button>
        </div>
      </form>

      <div class="modal__thankyou" aria-live="polite" hidden>
        <p>Thank you — your request has been received. I'll be in touch soon.</p>
      </div>
    </div>
  </dialog>
</div>
