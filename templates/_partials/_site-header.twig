{# _partials/_site-header.twig #}

<header class="site-header">
  <div class="l-site-header">
    <div class="logo-band">

      <div class="logo-outerbox">
        <a href="/work" class="logo-band-home-link">
          <span class="meh-title">MEH</span>
          <span class="hex">im hex ic</span>
        </a>
        <button class="menu-btn">
          <div class="rotate">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="M19 12.75H5a.75.75 0 0 1 0-1.5h14a.75.75 0 0 1 0 1.5m0-4.5H5a.75.75 0 0 1 0-1.5h14a.75.75 0 0 1 0 1.5m0 9H5a.75.75 0 0 1 0-1.5h14a.75.75 0 0 1 0 1.5"
              />
            </svg>
          </div>
        </button>
      </div>

      {% if entry is defined and entry.section.handle == 'work' %}
        {% set prevEntry = craft.entries()
          .section('work')
          .andWhere(['<', 'structureelements.lft', entry.lft])
          .orderBy('structureelements.lft desc')
          .one() ?? craft.entries().section('work').orderBy('structureelements.lft desc').one() %}

        {% set nextEntry = craft.entries()
          .section('work')
          .andWhere(['>', 'structureelements.lft', entry.lft])
          .orderBy('structureelements.lft asc')
          .one() ?? craft.entries().section('work').orderBy('structureelements.lft asc').one() %}

        <a href="{{ prevEntry.url }}" class="logo-band-btn logo-band-btn--prev">
          <i aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
              <path fill="currentColor" d="M15.41 16.59L10.83 12l4.58-4.59L14 6l-6 6 6 6z"/>
            </svg>
          </i>
          <span class="sr-only">Previous image</span>
        </a>

        <a href="{{ nextEntry.url }}" class="logo-band-btn logo-band-btn--next">
          <i aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
              <path fill="currentColor" d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/>
            </svg>
          </i>
          <span class="sr-only">Next image</span>
        </a>

        {% else %}
          <div class="logo-band-btn logo-band-btn--next"></div>
          <div class="logo-band-btn logo-band-btn--prev"></div>
      {% endif %}

    </div>

    {% include '_partials/_site-header-nav.twig' %}
  </div>
</header>
